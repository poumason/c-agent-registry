                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="31" value="activate（可重新上線）" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;html=1;endArrow=block;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;opacity=70;exitY=0.8;entryY=0.8;" parent="1" source="29" target="28" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="770" y="545"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="32" value="服務立即停止，但打包好的 zip 仍在 MinIO——只要 active 數 &lt; 2 就能再 activate 上線。" style="text;html=1;align=left;verticalAlign=top;fontSize=10.5;fontColor=#66707A;whiteSpace=wrap;" parent="1" vertex="1">
