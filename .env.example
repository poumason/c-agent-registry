# Postgres
POSTGRES_USER=agent_registry
POSTGRES_PASSWORD=agent_registry
POSTGRES_DB=agent_registry
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_SKILLS_BUCKET=skills
MINIO_PACKAGES_BUCKET=packages

# Auth
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Bootstrap admin (created on startup if no admin user exists)
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-admin
BOOTSTRAP_ADMIN_NAME=Administrator
