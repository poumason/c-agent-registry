# Postgres
POSTGRES_USER=agent_registry
POSTGRES_PASSWORD=agent_registry
POSTGRES_DB=agent_registry
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# pgAdmin (http://localhost:5050) - runs in desktop mode (no login screen, local dev
# only). Open the pre-configured "agent-registry (docker)" server and enter
# POSTGRES_PASSWORD above when it prompts for the database password.
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_SKILLS_BUCKET=skills
MINIO_PACKAGES_BUCKET=packages

# Auth
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Bootstrap admin (created on startup if no admin user exists)
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-admin
BOOTSTRAP_ADMIN_NAME=Administrator

# SSO (generic OIDC) - optional. Leave unset to disable SSO; password login (above)
# always keeps working regardless. Register BACKEND_BASE_URL + /api/v1/auth/sso/callback
# as an allowed redirect URI at the IdP.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
BACKEND_BASE_URL=http://localhost:8000
# Where the browser lands after SSO login (token appended as a URL fragment). Leave unset
# to have /auth/sso/callback return the token as JSON instead (useful before a frontend exists).
FRONTEND_SSO_REDIRECT_URL=
