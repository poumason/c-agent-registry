    <diagram id="Vk9nQxLifecycle01" name="Agent Version Lifecycle">
        <mxGraphModel dx="1378" dy="587" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="800" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="3" value="Agent Version Lifecycle — 建立 → 送審 → 上線；新增部署 fab／關閉版本" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="20" width="700" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="4" value="虛線框（draft / rejected）= 可編輯，能設定部署 fab、加/刪依賴、改參數。實線框 = 已鎖定。" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#66707A;" parent="1" vertex="1">
                    <mxGeometry x="40" y="50" width="700" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="5" value="draft&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:400&quot;&gt;建立版本&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;verticalAlign=middle;align=center;fillColor=#EEF1F4;strokeColor=#9AA7B2;dashed=1;fontColor=#3C4650;" parent="1" vertex="1">
                    <mxGeometry x="40" y="120" width="160" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="6" value="in_review&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:400&quot;&gt;等待審核決定&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;verticalAlign=middle;align=center;fillColor=#FCEFD2;strokeColor=#B8860B;fontColor=#7A5A08;" parent="1" vertex="1">
                    <mxGeometry x="300" y="120" width="160" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="7" value="approved&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:400&quot;&gt;zip 已打包至 MinIO&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;verticalAlign=middle;align=center;fillColor=#DCEFEA;strokeColor=#2E7D6B;fontColor=#1F5F51;" parent="1" vertex="1">
                    <mxGeometry x="560" y="120" width="160" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="8" value="active&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:400&quot;&gt;數量無上限，同 fab 可多版本&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;verticalAlign=middle;align=center;fillColor=#0E7C6B;strokeColor=#0B5F52;fontColor=#FFFFFF;" parent="1" vertex="1">
                    <mxGeometry x="820" y="120" width="160" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="9" value="rejected&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:400&quot;&gt;同一版本，可修改&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;verticalAlign=middle;align=center;fillColor=#F7E2DE;strokeColor=#B5432D;dashed=1;fontColor=#8C331F;" parent="1" vertex="1">
                    <mxGeometry x="300" y="280" width="160" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="10" value="submit&lt;br&gt;POST …/submit" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;elbow=vertical;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" source="5" target="6" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="11" value="decision: approved&lt;br&gt;POST reviews/{id}/decision" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;elbow=vertical;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" source="6" target="7" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="12" value="activate&lt;br&gt;POST …/activate" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;elbow=vertical;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" source="7" target="8" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="13" value="decision: rejected&lt;br&gt;POST reviews/{id}/decision" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;elbow=vertical;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" source="6" target="9" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="14" value="resubmit&lt;br&gt;POST …/submit" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;elbow=vertical;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" source="9" target="6" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="260" y="220"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="15" value="deactivate（= 關閉版本）&lt;br&gt;POST …/deactivate" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;html=1;endArrow=block;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;strokeColor=#B5432D;fontColor=#8C331F;" parent="1" source="8" target="7" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="900" y="260"/>
                            <mxPoint x="640" y="260"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="16" value="新增部署 fab 到既有版本" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="400" width="460" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="17" value="版本目前狀態？" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;strokeColor=#B7C1CA;fillColor=#FFFFFF;" parent="1" vertex="1">
                    <mxGeometry x="220" y="440" width="160" height="34" as="geometry"/>
                </mxCell>
                <mxCell id="18" value="PUT …/fabs&lt;br&gt;立即生效，新 fab 從 0 依賴開始" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;strokeColor=#B7C1CA;fillColor=#FFFFFF;align=center;verticalAlign=middle;strokeColor=#2E7D6B;fillColor=#DCEFEA;fontColor=#1F5F51;" parent="1" vertex="1">
                    <mxGeometry x="40" y="500" width="220" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="19" value="無端點可直接改&lt;br&gt;fab 清單在核准當下即鎖定" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;strokeColor=#B7C1CA;fillColor=#FFFFFF;align=center;verticalAlign=middle;strokeColor=#B5432D;fillColor=#F7E2DE;fontColor=#8C331F;" parent="1" vertex="1">
                    <mxGeometry x="300" y="500" width="220" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="20" value="再各別補依賴&lt;br&gt;POST …/dependencies（fab_id 必填）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;strokeColor=#B7C1CA;fillColor=#FFFFFF;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="40" y="570" width="220" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="21" value="建立新版本&lt;br&gt;回到 draft 重跑一次審核" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;strokeColor=#B7C1CA;fillColor=#FFFFFF;align=center;verticalAlign=middle;dashed=1;strokeColor=#9AA7B2;fillColor=#EEF1F4;fontColor=#3C4650;" parent="1" vertex="1">
                    <mxGeometry x="300" y="570" width="220" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="22" value="draft / rejected" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;elbow=vertical;fontSize=11;labelBackgroundColor=#ffffff;fontColor=#3C4650;" parent="1" source="17" target="18" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="23" value="approved / active" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;elbow=vertical;fontSize=11;labelBackgroundColor=#ffffff;fontColor=#8C331F;" parent="1" source="17" target="19" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;elbow=vertical;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" source="18" target="20" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;elbow=vertical;fontSize=11;labelBackgroundColor=#ffffff;" parent="1" source="19" target="21" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="26" value="" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;html=1;endArrow=block;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#9AA7B2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" parent="1" source="21" target="5" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="410" y="700"/>
                            <mxPoint x="120" y="700"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="27" value="關閉一個已上線的版本" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="600" y="400" width="400" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="28" value="active" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;verticalAlign=middle;align=center;fillColor=#0E7C6B;strokeColor=#0B5F52;fontColor=#FFFFFF;" parent="1" vertex="1">
                    <mxGeometry x="600" y="460" width="140" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="29" value="approved" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;verticalAlign=middle;align=center;fillColor=#DCEFEA;strokeColor=#2E7D6B;fontColor=#1F5F51;" parent="1" vertex="1">
                    <mxGeometry x="840" y="460" width="140" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="30" value="deactivate&lt;br&gt;POST …/deactivate" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;html=1;endArrow=block;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#B5432D;fontColor=#8C331F;exitY=0.2;entryY=0.2;" parent="1" source="28" target="29" edge="1">
                    <mxGeometry relative="1" as="geometry">
